@tailwind base;
@tailwind components;
@tailwind utilities;

@use "./variables.scss";
@use "./fonts.scss";

.icon-btn {
  @apply border-1.5 border-stroke rounded-lg w-12 h-12 flex items-center justify-center;
}

body {
  direction: rtl;
}

.tox-tinymce {
  border: 1.5px solid #eff3f8 !important;
}

.tox:not(.tox-tinymce-inline) .tox-editor-header {
  border-bottom: 1.5px solid #eff3f8 !important;
  box-shadow: none !important;
}

.custom-scrollbar {
  overflow-y: scroll;

  &::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  &::-webkit-scrollbar-thumb {
    background-color: #0a84ff;
    border-radius: 9999px;
  }

  &::-webkit-scrollbar-track {
    background-color: #e5e7eb;
  }

  scrollbar-width: thin;
  scrollbar-color: #0a84ff #e5e7eb;
}

.custom-checkbox {
  display: inline-flex;
  align-items: center;
  cursor: pointer;
  gap: 8px;
  user-select: none;

  input[type="checkbox"] {
    display: none;
  }

  .checkmark {
    width: 20px;
    height: 20px;
    border: 1.5px solid #5d7696;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: white;
    transition: background-color 0.3s ease;

    svg {
      width: 20px;
      height: 20px;
      stroke: white;
      stroke-width: 3;
      fill: none;
    }
  }

  input:checked+.checkmark {
    background-color: #0a84ff;
    border: 1.5px solid #0a84ff;
  }

  .label-text {
    font-size: 16px;
  }
}

.switch-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;

  &.disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .switch-label {
    font-size: 14px;
  }
}

.switch {
  position: relative;
  display: inline-block;
  width: 40px;
  height: 20px;

  input {
    opacity: 0;
    width: 0;
    height: 0;

    &:checked+.slider {
      background-color: #0a84ff;

      &::before {
        transform: translateX(20px);
      }
    }

    &:disabled+.slider {
      background-color: #ccc;

      &::before {
        background-color: #999;
      }
    }
  }

  .slider {
    position: absolute;
    cursor: pointer;
    background-color: #ccc;
    border-radius: 20px;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    transition: background-color 0.3s;

    &::before {
      content: "";
      position: absolute;
      height: 16px;
      width: 16px;
      left: 2px;
      bottom: 2px;
      background-color: white;
      transition: transform 0.3s;
      border-radius: 50%;
    }
  }
}

.site {
  .switch {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 20px;

    input {
      opacity: 0;
      width: 0;
      height: 0;

      &:checked+.slider {
        background-color: #c4161c;

        &::before {
          transform: translateX(20px);
        }
      }

      &:disabled+.slider {
        background-color: #ccc;

        &::before {
          background-color: #999;
        }
      }
    }

    .slider {
      position: absolute;
      cursor: pointer;
      background-color: #ccc;
      border-radius: 20px;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      transition: background-color 0.3s;

      &::before {
        content: "";
        position: absolute;
        height: 16px;
        width: 16px;
        left: 2px;
        bottom: 2px;
        background-color: white;
        transition: transform 0.3s;
        border-radius: 50%;
      }
    }
  }
}

.hidden-scrollbar {
  overflow: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;

  &::-webkit-scrollbar {
    display: none;
  }
}

.tox {
  font-family: "Estedad" !important;

  * {
    font-family: "Estedad" !important;
  }
}

input[type="number"] {
  -moz-appearance: textfield;

  &::-webkit-inner-spin-button,
  &::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
}

.tox-statusbar {
  display: none !important;
}

.tox .tox-editor-container {
  padding-bottom: 3px !important;
}

.bg-post-cover {
  background-color: rgba(1, 26, 57, 0.25);
}

.iiz__close {
  left: 10px !important;
  right: unset !important;
}