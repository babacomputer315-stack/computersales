export const getServerSideProps: GetServerSideProps = async (context) => {
  const { isMobileSSR } = detectDevice(context);
  try {
    const [
      { data: bannersResponse },
      { data: categoriesResponse },
      { data: productsResponse },
      { data: brandsResponse },
      { data: blogResponse },
    ] = await Promise.all([
      ssrBannerService.getBanners(),
      ssrCategoryService.getCategories(),
      ssrProductService.getProducts({
        limit: 40,
      }),
      ssrBrandService.getBrands(1, 10),
      ssrBlogService.getRecentPosts(4),
    ]);

    return {
      props: {
        isMobileSSR,
        banners: bannersResponse || [],
        products: productsResponse?.data || [],
        categories: categoriesResponse || [],
        brands: brandsResponse || [],
        blogPosts: blogResponse,
        randomCategory:
          categoriesResponse?.length > 0
            ? categoriesResponse[
                Math.floor(Math.random() * categoriesResponse.length)
              ]
            : null,
      },
    };
  } catch (error) {
    return {
      props: {
        isMobileSSR,
        banners: [],
        products: [],
        categories: [],
        brands: [],
        blogPosts: [],
        randomCategory: null,
      },
    };
  }
};



